{
  "name": "agentwarden",
  "version": "0.1.0",
  "description": "Let AI agents from one department query another department's database safely: puzzle-based identity, request risk scoring, SQL permission checks and a sandboxed executor.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "llm",
    "security",
    "database",
    "postgres",
    "sql",
    "access-control",
    "sandbox",
    "prompt-injection",
    "captcha"
  ],
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "default": "./dist/gateway/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "default": "./dist/demo/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run.mjs",
    "test:docker": "docker compose up -d --wait && node test/run.mjs docker"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "jose": "^6.1.0",
    "node-sql-parser": "^5.3.0"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
