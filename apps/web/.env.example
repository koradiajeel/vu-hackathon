# Local mode: everything runs inside this Next.js server. No cloud services needed.
# Copy to .env.local and fill the two secrets (any long random strings).
NEXT_PUBLIC_CAPAGENT_API_BASE_URL=http://localhost:3000/api/capgent
CAPAGENT_API_BASE_URL=http://localhost:3000/api/capgent
CAPAGENT_PUBLIC_BASE_URL=http://localhost:3000/api/capgent
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
SESSION_SECRET=
CAPAGENT_JWT_SECRET=
CAPAGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CAPAGENT_FORCE_INMEMORY=1
# Optional: lets the playground use an LLM to read challenge instructions
OPENROUTER_API_KEY=
